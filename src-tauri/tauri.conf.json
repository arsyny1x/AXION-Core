{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXION Core",
  "version": "0.1.0",
  "identifier": "com.axion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AXION Core — Lua SDK Central Management",
        "width": 1250,
        "height": 700,
        "minWidth": 1250,
        "minHeight": 700,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
